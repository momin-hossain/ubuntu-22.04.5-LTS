#!/bin/bash
# Charger plugged / unplugged -> sound + notification + clock seconds on AC.
# Event-driven: waits for the kernel's power_supply event instead of polling
# every second (old version: ~6 process forks/second all day). A 20 s timeout
# keeps it correct even if an event is ever missed.
exec 9>/tmp/charger-notify.lock; flock -n 9 || exit 0
ac_state() {
  for d in /sys/class/power_supply/*; do
    if [ "$(cat "$d/type" 2>/dev/null)" = "Mains" ]; then
      cat "$d/online" 2>/dev/null
      return
    fi
  done
  echo 1
}
apply_mode() {
  if [ "$1" = "1" ]; then   # on charger: full speed (CPU turbo stays responsive)
    gsettings set org.gnome.desktop.interface clock-show-seconds true
    powerprofilesctl set performance 2>/dev/null
  else                      # on battery: balanced, saves battery
    gsettings set org.gnome.desktop.interface clock-show-seconds false
    powerprofilesctl set balanced 2>/dev/null
  fi
}
notified=$(ac_state)
apply_mode "$notified"
while true; do
  read -r -t 20 _      # wake on a power_supply event, or after 20 s anyway
  sleep 2              # let the plug/unplug settle (same debounce as before)
  now=$(ac_state)
  [ "$now" = "$notified" ] && continue
  apply_mode "$now"
  if [ "$now" = "1" ]; then
    paplay /usr/share/sounds/Yaru/stereo/device-added.oga &
    notify-send -a Charger -i battery-full-charging "Charger connected" "Running on AC power"
  else
    paplay /usr/share/sounds/Yaru/stereo/device-removed.oga &
    notify-send -a Charger -i battery-low "Charger disconnected" "Battery saver on"
  fi
  notified=$now
done < <(exec 9>&-; stdbuf -oL udevadm monitor --udev --subsystem-match=power_supply 2>/dev/null)
# (9>&- : udevadm must not inherit the lock, or a restart after logout would be blocked)
